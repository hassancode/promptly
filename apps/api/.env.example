# =============================================================================
# Promptly API Environment Configuration
# Task: T005, T211 [Phase 1, Phase 9]
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://promptly:promptly_dev_password@localhost:5432/promptly

# -----------------------------------------------------------------------------
# REDIS
# Session store and rate limiting cache
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Session configuration
SESSION_TTL_SECONDS=604800        # 7 days (default)
SESSION_COOKIE_NAME=promptly_session

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (enables hot reload, detailed errors)
DEBUG=true

# Secret key for session encryption (CHANGE IN PRODUCTION!)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_in_production

# -----------------------------------------------------------------------------
# AI PROVIDER API KEYS
# Only configure keys for providers you want to enable
# Keys for disabled providers are ignored
# -----------------------------------------------------------------------------

# OpenAI (ChatGPT)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Anthropic (Claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google (Gemini)
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_key_here

# Perplexity
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_key_here

# Google AI Search (Custom Search API)
# Get credentials at: https://console.cloud.google.com/
GOOGLE_AI_API_KEY=your_google_ai_key_here
GOOGLE_AI_CX=your_custom_search_engine_id_here

# HuggingFace
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_key_here

# -----------------------------------------------------------------------------
# PROVIDER CONFIGURATION
# Comma-separated list of providers to enable
# Available: openai, claude, gemini, perplexity, google_ai, huggingface
#
# Examples:
#   ENABLED_PROVIDERS=openai              # Only OpenAI
#   ENABLED_PROVIDERS=openai,claude       # OpenAI and Claude
#   ENABLED_PROVIDERS=openai,claude,gemini,perplexity,google_ai,huggingface  # All
#
# NOTE: At least one provider must be enabled!
# -----------------------------------------------------------------------------
ENABLED_PROVIDERS=openai,claude,gemini,perplexity,google_ai,huggingface

# -----------------------------------------------------------------------------
# RATE LIMITING
# Analysis rate limit per user
# -----------------------------------------------------------------------------
ANALYSIS_RATE_LIMIT=10            # Max analyses per hour (default: 10)
RATE_LIMIT_WINDOW_SECONDS=3600    # Rate limit window in seconds (default: 1 hour)

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# Frontend origins allowed to access the API
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# In production, set to your actual frontend domain:
# CORS_ORIGINS=https://app.promptly.ai

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                   # json or text

# -----------------------------------------------------------------------------
# TIMEOUTS
# AI provider request timeouts
# -----------------------------------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=30       # Timeout for individual provider requests
ANALYSIS_TIMEOUT_SECONDS=120      # Overall analysis timeout
